<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_toast_background"
    android:elevation="16dp">

    <!-- Header: icon + app name + timestamp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@drawable/overlay_header_divider">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/headerIconFrame"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/header_icon_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/headerIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat"
                    android:tint="@color/on_primary_container" />
            </FrameLayout>

            <TextView
                android:id="@+id/appNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="APP NAME"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just now"
            android:textColor="@color/outline"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Content: avatar + text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/avatarImage"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="@drawable/fallback_icon_bg"
                android:clipToOutline="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/fallbackIndicator"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/fallback_icon_bg"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/fallbackGlyph"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person_placeholder"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <ImageView
                android:id="@+id/onlineDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|right"
                android:layout_marginBottom="-2dp"
                android:layout_marginRight="-2dp"
                android:src="@drawable/online_indicator"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification Title"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Notification body message goes here."
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/primaryActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/action_button_primary_bg"
            android:text="Read More"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_open_in_full"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/secondaryActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/action_button_secondary_bg"
            android:text="Dismiss"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_close"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- Remote hint bar -->
    <LinearLayout
        android:id="@+id/remoteHintRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:background="#26444655"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="BACK"
                android:textColor="@color/surface_dim"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/remote_key_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="to close"
                android:textColor="@color/outline"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="OK"
                android:textColor="@color/surface_dim"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/remote_key_bg_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="to view"
                android:textColor="@color/outline"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
