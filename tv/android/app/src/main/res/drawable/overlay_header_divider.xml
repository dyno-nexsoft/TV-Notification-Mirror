<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent background with a single 1dp divider line at the bottom of
     the header. The old full-bleed solid fill covered the overlay root's
     1dp border stroke at the top/left/right edges, hiding the card outline
     around the header region — the transparent version lets the root's
     rounded border show through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="0dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="@color/outline_variant" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>
